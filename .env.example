# Browser-visible key. Restrict allowed origins in NAVER Cloud Console.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kakao Developers JavaScript key. Register both local and production web domains.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Browser-visible Google Maps JavaScript key. Restrict it by web origins and API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
NAVER_MAP_CLIENT_SECRET=
KOREA_EXPRESSWAY_API_KEY=

# Optional: enables restaurant, cafe, attraction and business search.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Server-only key for Google Routes API and Places API (New).
GOOGLE_MAPS_API_KEY=
