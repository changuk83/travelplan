{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gildam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://gildam.changuk83.workers.dev,https://gildam-trip.changuk83.chatgpt.site"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gildam-db",
      "database_id": "ea6fc834-f481-4207-916c-a5388093853e",
      "migrations_dir": "migrations"
    }
  ]
}
